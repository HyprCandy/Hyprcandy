windowrule = opacity 1.0 $& 1.0 $& 1,match:class ^([Ss]potify)$
windowrule = opacity 1.0 $& 1.0 $& 1,match:title ^(Spotify Free)$
windowrule = opacity 1.0 $& 1.0 $& 1,match:title ^(Spotify Premium)$
